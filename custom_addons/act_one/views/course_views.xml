<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_course_search" model="ir.ui.view">
            <field name="name">course.search</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
                <search string="Search Courses">
                    <field name="name" string="Course Title"/>
                    <field name="description"/>
                    
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="All Courses" name="all_course" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="view_course_list" model="ir.ui.view">
            <field name="name">course.list</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
                <list string="Courses" 
                      decoration-danger="available_seats == 0 or active == False" 
                      decoration-success="available_seats &gt; 0 and active == True">
                    
                    <field name="serial_number"/>
                    <field name="name" class="fw-bold"/>
                    <field name="teacher_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="total_seats" optional="hide"/>
                    
                    <field name="available_seats" string="Available Seats"/>
                    
                    <field name="active" widget="boolean_toggle" string="Is Active"/>
                </list>
            </field>
        </record>

        <record id="view_course_form" model="ir.ui.view">
            <field name="name">course.form</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="serial_number"/>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="teacher_id"/>
                            <field name="active"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="number_of_days"/>
                            <field name="time" widget="float_time"/>
                            <field name="room_id"/>
                            <field name="location_id"/>
                            <field name="total_seats"/>
                            <field name="available_seats"/>
                            <field name="target_gender"/>
                            <field name="deadline"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="course_model_action" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">course</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]</field>
            <field name="search_view_id" ref="view_course_search"/>
            <field name="context">{
                'search_default_all_course': 1
            }</field>
        </record>

    </data>
</odoo>
