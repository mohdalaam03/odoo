<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_course_search" model="ir.ui.view">
            <field name="name">course.search</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
                <search string="Search Courses">
                    <field name="name" string="Course Title"/>
                    <field name="description"/>
                    
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="All Courses" name="all_course" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="view_location_search" model="ir.ui.view">
            <field name="name">location.search</field>
            <field name="model">location</field>
            <field name="arch" type="xml">
                <search string="Search Locations">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="view_room_search" model="ir.ui.view">
            <field name="name">room.search</field>
            <field name="model">room</field>
            <field name="arch" type="xml">
                <search string="Search Rooms">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="view_teacher_search" model="ir.ui.view">
            <field name="name">teacher.search</field>
            <field name="model">teacher</field>
            <field name="arch" type="xml">
                <search string="Search Teachers">
                    <field name="name"/>
                </search>
            </field>
        </record>



        <record id="view_course_list_enhanced" model="ir.ui.view">
            <field name="name">course.list.enhanced</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
                <list string="Courses" 
                      decoration-danger="available_seats == 0 or active == False" 
                      decoration-success="available_seats &gt; 0 and active == True">
                    
                    <field name="serial_number"/>
                    <field name="name" class="fw-bold"/>
                    <field name="teacher_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="total_seats" optional="hide"/>
                    
                    <field name="available_seats" string="Available Seats"/>
                    
                    <field name="active" widget="boolean_toggle" string="Is Active"/>
                </list>
            </field>
        </record>

        <record id="view_course_form" model="ir.ui.view">
            <field name="name">course.form</field>
            <field name="model">course</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="serial_number"/>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="teacher_id"/>
                            <field name="active"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="number_of_days"/>
                            <field name="time" widget="float_time"/>
                            <field name="room_id"/>
                            <field name="location_id"/>
                            <field name="total_seats"/>
                            <field name="available_seats"/>
                            <field name="target_gender"/>
                            <field name="deadline"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        


        <record id="view_location_list" model="ir.ui.view">
            <field name="name">location.list</field>
            <field name="model">location</field>
            <field name="arch" type="xml">
                <list string="Locations">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="view_location_form" model="ir.ui.view">
    <field name="name">location.form</field>
    <field name="model">location</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

        <record id="view_room_list" model="ir.ui.view">
            <field name="name">room.list</field>
            <field name="model">room</field>
            <field name="arch" type="xml">
                <list string="Rooms">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="view_room_form" model="ir.ui.view">
    <field name="name">room.form</field>
    <field name="model">room</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

        <record id="view_teacher_list" model="ir.ui.view">
            <field name="name">teacher.list</field>
            <field name="model">teacher</field>
            <field name="arch" type="xml">
                <list string="Teachers">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="view_teacher_form" model="ir.ui.view">
            <field name="name">teacher.form</field>
            <field name="model">teacher</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>

                            <field name="user_id" string="Related User Account"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>



        <record id="course_model_action" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">course</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]</field>
            <field name="search_view_id" ref="view_course_search"/>
            <field name="context">{
                'search_default_all_course': 1
            }</field>
        </record>

        <record id="action_my_courses" model="ir.actions.act_window">
            <field name="name">My Courses</field>
            <field name="res_model">registration</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('trainee_id', '=', uid)]</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
            <field name="view_id" ref="act_one.view_my_courses_list"/>
        </record>

        <record id="location_model_action" model="ir.actions.act_window">
            <field name="name">Locations</field>
            <field name="res_model">location</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="room_model_action" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">room</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="teacher_model_action" model="ir.actions.act_window">
            <field name="name">Teachers</field>
            <field name="res_model">teacher</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="registration_model_menu_action" name="Training Module"/>
        
        <menuitem id="reg_sub_menu_action" name="Registration" action="registration_model_action" 
                    parent="registration_model_menu_action"
                    groups="act_one.group_training_requester,act_one.group_training_teacher,act_one.group_training_hr"/>

        <menuitem id="my_courses_menu_action" name="My Courses" action="action_my_courses" 
                  parent="registration_model_menu_action" 
                  groups="act_one.group_training_requester"/>

        <menuitem id="course_model_menu_action" name="Courses" action="course_model_action" 
                  parent="registration_model_menu_action" 
                  groups="act_one.group_training_hr"/>
                  
        <menuitem id="location_model_menu_action" name="Locations" action="location_model_action" 
                  parent="registration_model_menu_action" 
                  groups="act_one.group_training_hr"/>
                  
        <menuitem id="room_model_menu_action" name="Rooms" action="room_model_action" 
                  parent="registration_model_menu_action" 
                  groups="act_one.group_training_hr"/>
                  
        <menuitem id="teacher_model_menu_action" name="Teachers" action="teacher_model_action" 
                  parent="registration_model_menu_action" 
                  groups="act_one.group_training_hr"/>
                  
    </data>
</odoo>
