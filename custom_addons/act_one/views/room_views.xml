<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_room_search" model="ir.ui.view">
            <field name="name">room.search</field>
            <field name="model">room</field>
            <field name="arch" type="xml">
                <search string="Search Rooms">
                    <field name="name"/>
                    <field name="code"/>
                </search>
            </field>
        </record>

        <record id="view_room_list" model="ir.ui.view">
            <field name="name">room.list</field>
            <field name="model">room</field>
            <field name="arch" type="xml">
                <list string="Rooms">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="view_room_form" model="ir.ui.view">
            <field name="name">room.form</field>
            <field name="model">room</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="room_model_action" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">room</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_room_search"/>
        </record>

    </data>
</odoo>
