<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Sequence for Location Code -->
        <record id="seq_location_code" model="ir.sequence">
            <field name="name">Location Code Sequence</field>
            <field name="code">location.code.seq</field>
            <field name="prefix">LOC</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- 2. Sequence for Room Code -->
        <record id="seq_room_code" model="ir.sequence">
            <field name="name">Room Code Sequence</field>
            <field name="code">room.code.seq</field>
            <field name="prefix">RM</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- 3. Sequence for Teacher Code -->
        <record id="seq_teacher_code" model="ir.sequence">
            <field name="name">Teacher Code Sequence</field>
            <field name="code">teacher.code.seq</field>
            <field name="prefix">TCH</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

         <!-- 4. Sequence for Course Serial Number -->
        <record id="seq_course_serial" model="ir.sequence">
            <field name="name">Course Serial Number Sequence</field>
            <field name="code">course.serial.seq</field>
            <field name="prefix">CRS-%(year)s-</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- 5. Sequence for Registration Serial Number -->
        <record id="seq_registration_serial" model="ir.sequence">
            <field name="name">Registration Serial Number Sequence</field>
            <field name="code">registration.serial.seq</field>
            <field name="prefix">REG-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
