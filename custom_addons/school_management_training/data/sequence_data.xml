<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- =================================================================
        SEQUENCES
        ================================================================== -->
        <!-- 
        Sequences are used to generate unique identifiers.
        These are pre-configured for the trainees.
        -->
        
        <!-- Student Sequence -->
        <record id="seq_school_student" model="ir.sequence">
            <field name="name">School Student Sequence</field>
            <field name="code">school.student.sequence</field>
            <field name="prefix">STU/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Teacher Sequence -->
        <record id="seq_school_teacher" model="ir.sequence">
            <field name="name">School Teacher Sequence</field>
            <field name="code">school.teacher.sequence</field>
            <field name="prefix">TCH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Course Sequence -->
        <record id="seq_school_course" model="ir.sequence">
            <field name="name">School Course Sequence</field>
            <field name="code">school.course.sequence</field>
            <field name="prefix">CRS/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Enrollment Sequence -->
        <record id="seq_school_enrollment" model="ir.sequence">
            <field name="name">School Enrollment Sequence</field>
            <field name="code">school.enrollment.sequence</field>
            <field name="prefix">ENR/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
