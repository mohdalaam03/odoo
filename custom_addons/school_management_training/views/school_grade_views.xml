<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    GRADE VIEWS
    ================================================================== -->
    
    <!-- Grade List View -->
    <record id="view_school_grade_list" model="ir.ui.view">
        <field name="name">school.grade.list</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <list string="Grades" multi_edit="1" sample="1"
                  decoration-success="letter_grade in ('A', 'B')"
                  decoration-warning="letter_grade == 'C'"
                  decoration-danger="letter_grade in ('D', 'F')">
                <field name="date"/>
                <!-- TODO: Add student_id, course_id, grade_type -->
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="grade_type"/>
                <!-- TODO: Add score, max_score, percentage, letter_grade -->
                <field name="score"/>
                <field name="max_score"/>
                <field name="percentage"/>
                <field name="letter_grade" widget="badge"/>
                <!-- TODO: Add is_passing with widget -->
                <field name="is_passing" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <!-- Grade Form View -->
    <record id="view_school_grade_form" model="ir.ui.view">
        <field name="name">school.grade.form</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <form string="Grade">
                <sheet>
                    <group>
                        <group string="Grade Details">
                            <field name="date"/>
                            <!-- TODO: Add student_id, course_id -->
                            <field name="student_id"/>
                            <field name="course_id"/>
                            <!-- TODO: Add grade_type, description -->
                            <field name="grade_type"/>
                            <field name="description"/>
                        </group>
                        <group string="Score">
                            <!-- TODO: Add score, max_score -->
                            <field name="score"/>
                            <field name="max_score"/>
                            <!-- TODO: Add percentage, letter_grade (readonly) -->
                            <field name="percentage" readonly="1"/>
                            <field name="letter_grade" widget="badge" readonly="1"/>
                            <!-- TODO: Add weight, weighted_score (readonly) -->
                            <field name="weight"/>
                            <field name="weighted_score" readonly="1"/>
                        </group>
                    </group>
                    <group string="Feedback">
                        <field name="feedback" placeholder="Provide teacher feedback or grading commentary here..." nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Grade Search View -->
    <record id="view_school_grade_search" model="ir.ui.view">
        <field name="name">school.grade.search</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <search string="Search Grades">
                <field name="date"/>
                <!-- TODO: Add search fields for student_id, course_id -->
                <field name="student_id"/>
                <field name="course_id"/>
                <!-- TODO: Add filters for passing/failing, grade type -->
                <filter string="Passing Grades" name="filter_passing" domain="[('is_passing', '=', True)]"/>
                <filter string="Failing Grades" name="filter_failing" domain="[('is_passing', '=', False)]"/>
                <separator/>
                <filter string="Exams" name="type_exam" domain="[('grade_type', '=', 'exam')]"/>
                <filter string="Quizzes" name="type_quiz" domain="[('grade_type', '=', 'quiz')]"/>
                <filter string="Homework" name="type_homework" domain="[('grade_type', '=', 'homework')]"/>
                <separator/>
                <!-- TODO: Add group by options -->
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Course" name="group_by_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Grade Type" name="group_by_type" context="{'group_by': 'grade_type'}"/>
                    <filter string="Letter Grade" name="group_by_letter" context="{'group_by': 'letter_grade'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="view_school_grade_pivot" model="ir.ui.view">
        <field name="name">school.grade.pivot</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <pivot string="Grade Analysis" sample="1">
                <!-- TODO: Configure pivot view -->
                <!-- Row: student_id, Column: course_id, Measure: score (avg) -->
                <field name="student_id" type="row"/>
                <field name="course_id" type="col"/>
                <field name="percentage" type="measure"/>
            </pivot>
        </field>
    </record>
    
    <!-- Grade Graph View -->
    <record id="view_school_grade_graph" model="ir.ui.view">
        <field name="name">school.grade.graph</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <graph string="Grade Distribution" type="bar" sample="1">
                <!-- TODO: Configure graph view -->
                <field name="course_id" type="row"/>
                <field name="percentage" type="measure"/>
            </graph>
        </field>
    </record>
    
    <!-- Grade Action -->
    <record id="action_school_grade" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">school.grade</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_school_grade_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first grade!
            </p>
        </field>
    </record>
</odoo>
