<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    REPORT ACTIONS
    ================================================================== -->
    <!--
    Report actions define printable reports.
    
    Concepts covered:
    - ir.actions.report configuration
    - Paper format
    - Report naming
    - Binding to models
    -->
    
    <!-- Student Report Card -->
    <record id="action_report_student_card" model="ir.actions.report">
        <field name="name">Student Report Card</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management_training.report_student_card</field>
        <field name="report_file">school_management_training.report_student_card</field>
        <field name="print_report_name">'Student Report Card - %s' % object.display_name</field>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">report</field>
    </record>
    
    <!-- Student List Report -->
    <record id="action_report_student_list" model="ir.actions.report">
        <field name="name">Student List</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management_training.report_student_list</field>
        <field name="report_file">school_management_training.report_student_list</field>
        <field name="print_report_name">'Student List'</field>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">report</field>
    </record>
    
    <!-- Course Detail Report -->
    <record id="action_report_course_detail" model="ir.actions.report">
        <field name="name">Course Detail</field>
        <field name="model">school.course</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management_training.report_course_detail</field>
        <field name="report_file">school_management_training.report_course_detail</field>
        <field name="print_report_name">'Course - %s' % object.name</field>
        <field name="binding_model_id" ref="model_school_course"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
