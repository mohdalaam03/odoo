<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================
    ENROLLMENT WIZARD VIEW
    ================================================================== -->
    
    <record id="view_school_enrollment_wizard_form" model="ir.ui.view">
        <field name="name">school.enrollment.wizard.form</field>
        <field name="model">school.enrollment.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Enrollment">
                <group>
                    <group>
                        <field name="course_id"/>
                        <!-- TODO: Add enrollment_date, skip_prerequisites -->
                        <field name="enrollment_date"/>
                        <field name="skip_prerequisites" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <!-- TODO: Add send_notification -->
                        <field name="send_notification" widget="boolean_toggle"/>
                        <!-- TODO: Add available_seats (readonly), student_count (readonly) -->
                        <field name="available_seats" readonly="1"/>
                        <field name="student_count" readonly="1"/>
                    </group>
                </group>
                
                <group string="Students">
                    <!-- TODO: Add student_ids Many2many with widget -->
                    <!-- Hint: widget="many2many_tags" or a list view -->
                    <field name="student_ids" nolabel="1" placeholder="Click to select student profiles for batch processing...">
                        <list string="Selected Students">
                            <field name="student_code"/>
                            <field name="name"/>
                            <field name="last_name"/>
                            <field name="age"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </group>
                
                <group string="Notes">
                    <!-- TODO: Add notes field -->
                    <field name="notes" placeholder="Add optional batch processing commentary or authorization overrides..." nolabel="1"/>
                </group>
                
                <!-- TODO: Add warning_message field (readonly) -->
                <group invisible="not warning_message">
                    <div class="alert alert-warning role='alert' class='mb-0 fw-bold'">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <field name="warning_message" readonly="1" nolabel="1"/>
                    </div>
                </group>
                
                <footer>
                    <button name="action_enroll" string="Enroll Students" 
                            type="object" class="btn-primary"/>
                    <button name="action_enroll_and_new" string="Enroll &amp; New" 
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_enrollment_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Enrollment</field>
        <field name="res_model">school.enrollment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    
    <!-- =================================================================
    BULK GRADE WIZARD VIEW
    ================================================================== -->
    
    <record id="view_school_bulk_grade_wizard_form" model="ir.ui.view">
        <field name="name">school.bulk.grade.wizard.form</field>
        <field name="model">school.bulk.grade.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Grade Entry">
                <group>
                    <group>
                        <field name="course_id" options="{'no_create': True}"/>
                        <!-- TODO: Add grade_date, grade_type -->
                        <field name="grade_date"/>
                        <field name="grade_type"/>
                    </group>
                    <group>
                        <!-- TODO: Add max_score, description -->
                        <field name="max_score"/>
                        <field name="description" placeholder="e.g. Midterm Examination, Assignment 1..."/>
                    </group>
                </group>
                
                <group string="Student Grades">
                    <!-- TODO: Add line_ids One2many -->
                    <!--
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="student_id"/>
                            <field name="score"/>
                            <field name="feedback"/>
                        </list>
                    </field>
                    -->
                    <field name="line_ids" nolabel="1">
                        <list string="Student Grades" editable="bottom" create="0">
                            <field name="student_id" 
                                force_save="1" options="{'no_open': True}"/>
                            <field name="score"/>
                            <field name="feedback" placeholder="Provide optional instructor grading notes..."/>
                        </list>
                    </field>
                </group>
                
                <footer>
                    <button name="action_save_grades" string="Save Grades" 
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_bulk_grade_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Grade Entry</field>
        <field name="res_model">school.bulk.grade.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    
    <!-- =================================================================
    BULK ATTENDANCE WIZARD VIEW
    ================================================================== -->
    
    <record id="view_school_bulk_attendance_wizard_form" model="ir.ui.view">
        <field name="name">school.bulk.attendance.wizard.form</field>
        <field name="model">school.bulk.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Attendance">
                <group>
                    <group>
                        <field name="course_id"/>
                        <field name="attendance_date"/>
                    </group>
                    <group string="Global Time Parameters">
                        <field name="check_in" placeholder="Select uniform class start time"/>
                        <field name="check_out" placeholder="Select uniform class end time"/>
                    </group>
                </group>
                
                <group string="Student Attendance">
                    <!-- TODO: Add line_ids One2many -->
                    <field name="line_ids" nolabel="1">
                        <list string="Student Attendance" editable="bottom" create="0" delete="0">
                            <field name="student_id"
                                force_save="1"
                                options="{'no_open': True}"/>
                            <field name="status" options="{'horizontal': true}"/>
                            <field name="remarks" placeholder="e.g. Excused, Late arrival..."/>
                        </list>
                    </field>
                </group>
                
                <footer>
                    <!-- TODO: Add action_mark_all_present, action_save buttons -->
                    <button name="action_mark_all_present" string="Mark All Present" 
                            type="object" class="btn-secondary"/>
                    <button name="action_save_attendance" string="Save Attendance" 
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_bulk_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Attendance</field>
        <field name="res_model">school.bulk.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
